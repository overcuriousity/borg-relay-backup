[Unit]
Description=borg-relay backup
Wants=network-online.target
After=network-online.target
OnFailure=borg-relay-notify@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/borg-relay/bin/borg-relay-backup
TimeoutStartSec=12h
KillMode=mixed
TimeoutStopSec=5min
Nice=10
IOSchedulingClass=idle
